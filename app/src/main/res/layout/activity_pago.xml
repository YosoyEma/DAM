<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary"
    tools:context=".PagoActivity">

    <!-- ========================= -->
    <!-- BARRA SUPERIOR            -->
    <!-- ========================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/navbarPago"
        style="@style/Navbar"
        android:layout_width="match_parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:title="@string/registrar_pago" />


    <!-- ========================= -->
    <!-- CONTENIDO                 -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/formPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">


            <!-- ========================= -->
            <!-- BÚSQUEDA                  -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/txtBuscar"
                style="@style/H3Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buscar_persona" />


            <!-- Campo de búsqueda + botón -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBuscar"
                    style="@style/InputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtBuscar"
                        style="@style/InputField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/buscar_dni"
                        android:inputType="number" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuscar"
                    style="@style/ButtonPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/buscar" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- PERSONA ENCONTRADA        -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/contenedorPersona"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@color/light_blue"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Icono de persona -->
                <ImageView
                    android:id="@+id/imgPersona"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/persona"
                    android:src="@drawable/ic_user"
                    app:tint="@color/primary" />


                <!-- Datos de la persona -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">


                    <!-- Nombre + tipo de persona -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtNombrePersona"
                            style="@style/InputTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/txtTipoPersona"
                            style="@style/SmallText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp" />

                    </LinearLayout>


                    <!-- DNI -->
                    <TextView
                        android:id="@+id/txtDetallePersona"
                        style="@style/SmallText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ========================= -->
            <!-- MONTO                     -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/lblMonto"
                style="@style/InputTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/edtMonto"
                android:text="@string/monto" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutMonto"
                style="@style/InputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtMonto"
                    style="@style/InputField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ========================= -->
            <!-- MEDIO DE PAGO             -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/lblMedioPago"
                style="@style/InputTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/dropdownMedioPago"
                android:text="@string/medio_pago" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutMedioPago"
                style="@style/DropdownLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:placeholderText="@string/seleccionar_medio_pago">

                <AutoCompleteTextView
                    android:id="@+id/dropdownMedioPago"
                    style="@style/InputField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:cursorVisible="false" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ========================= -->
            <!-- CUOTAS                    -->
            <!-- ========================= -->

            <!--
                Este bloque comienza oculto.
                Se mostrará únicamente cuando:
                - la persona sea Socio
                - el medio de pago sea Tarjeta de crédito
            -->
            <LinearLayout
                android:id="@+id/contenedorCuotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/lblCuotas"
                    style="@style/InputTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cuotas" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleCuotas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCuota1"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/cuota_1"
                        android:textColor="@color/cuota_button_text"
                        app:backgroundTint="@color/cuota_button_background" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCuota3"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/cuota_3"
                        android:textColor="@color/cuota_button_text"
                        app:backgroundTint="@color/cuota_button_background" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCuota6"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/cuota_6"
                        android:textColor="@color/cuota_button_text"
                        app:backgroundTint="@color/cuota_button_background" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>


            <!-- ========================= -->
            <!-- GUARDAR                   -->
            <!-- ========================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarPago"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:enabled="false"
                android:text="@string/guardar" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>