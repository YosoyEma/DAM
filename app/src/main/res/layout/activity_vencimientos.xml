<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary"
    tools:context=".VencimientosActivity">

    <!-- ========================= -->
    <!-- BARRA SUPERIOR            -->
    <!-- ========================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/navbarVencimientos"
        style="@style/Navbar"
        android:layout_width="match_parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:title="@string/vencimientos" />


    <!-- ========================= -->
    <!-- CONTENEDOR INFERIOR       -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/background">

        <!-- ========================= -->
        <!-- INDICADORES               -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp">

            <!-- Vencen Hoy -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/warning_light"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        style="@style/SmallText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vencen_hoy"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/txtVencenHoy"
                        style="@style/H3Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/warning"
                        tools:text="3" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Deudores -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/danger_light"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        style="@style/SmallText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/deudores"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/txtDeudores"
                        style="@style/H3Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/danger"
                        tools:text="4" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Total Socios -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/primary_light"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        style="@style/SmallText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_socios"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/txtTotalSocios"
                        style="@style/H3Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary"
                        tools:text="10" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- ========================= -->
        <!-- FILTROS                   -->
        <!-- ========================= -->

        <RadioGroup
            android:id="@+id/radioGroupFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <!-- Deudores -->
            <RadioButton
                android:id="@+id/radioDeudores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:button="@drawable/radio_filter_selector"
                app:buttonTint="@color/radio_checked_tint"
                android:paddingStart="6dp"
                android:paddingEnd="0dp"
                android:checked="true"
                android:text="@string/filtro_deudores"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_input" />

            <!-- Vencen hoy -->
            <RadioButton
                android:id="@+id/radioVencenHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/radio_filter_selector"
                app:buttonTint="@color/radio_checked_tint"
                android:paddingStart="6dp"
                android:paddingEnd="0dp"
                android:text="@string/filtro_vencen_hoy"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_input" />

        </RadioGroup>

        <!-- ========================= -->
        <!-- LISTADO DE VENCIMIENTOS   -->
        <!-- ========================= -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:id="@+id/contenedorVencimientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <!-- ========================= -->
        <!-- BOTÓN IMPRIMIR            -->
        <!-- ========================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImprimir"
            style="@style/ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/imprimir" />

    </LinearLayout>

</LinearLayout>