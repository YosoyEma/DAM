<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary"
    tools:context=".PrincipalActivity">

    <!-- ========================= -->
    <!-- BARRA SUPERIOR            -->
    <!-- ========================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/navbarPrincipal"
        style="@style/Navbar"
        android:layout_width="match_parent"
        app:title="@string/saludo_admin">

        <ImageButton
            android:id="@+id/btnCerrarSesion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cerrar_sesion"
            android:padding="8dp"
            android:src="@drawable/ic_logout"
            app:tint="@color/white" />

    </com.google.android.material.appbar.MaterialToolbar>


    <!-- ========================= -->
    <!-- CONTENEDOR INFERIOR       -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/background">

        <!-- ========================= -->
        <!-- CONTENIDO PRINCIPAL       -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/contenidoPrincipal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/txtGestionar"
                style="@style/H3Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/que_deseas_gestionar" />

            <!-- PRIMERA FILA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <include
                    android:id="@+id/cardNuevoSocio"
                    layout="@layout/component_home_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp" />

                <include
                    android:id="@+id/cardVisitantes"
                    layout="@layout/component_home_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- SEGUNDA FILA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <include
                    android:id="@+id/cardPagos"
                    layout="@layout/component_home_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp" />

                <include
                    android:id="@+id/cardVencimientos"
                    layout="@layout/component_home_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================= -->
        <!-- NAVEGACIÓN INFERIOR       -->
        <!-- ========================= -->

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            style="@style/BottomNav"
            android:layout_width="match_parent"
            app:menu="@menu/bottom_nav_menu"
            app:itemIconTint="@color/bottom_nav_colors"
            app:itemTextColor="@color/bottom_nav_colors" />

    </LinearLayout>

</LinearLayout>