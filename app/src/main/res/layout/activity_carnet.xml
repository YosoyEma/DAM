<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ========================= -->
    <!-- BARRA SUPERIOR            -->
    <!-- ========================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Navbar"
        android:layout_width="match_parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:title="@string/carnet_socio" />


    <!-- ========================= -->
    <!-- CONTENIDO                 -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Encabezado de la vista previa -->

            <LinearLayout
                android:id="@+id/headerClub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgLogoClub"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/logo_club"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_club_medium" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloClub"
                        style="@style/H3Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/titulo_club" />

                    <TextView
                        android:id="@+id/txtVistaPrevia"
                        style="@style/SmallText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/vista_previa_carnet" />

                </LinearLayout>

            </LinearLayout>


            <!-- ========================= -->
            <!-- CARNET                    -->
            <!-- ========================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCarnet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Encabezado gráfico -->

                    <ImageView
                        android:id="@+id/imgEncabezadoCarnet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/encabezado_carnet"
                        android:scaleType="fitCenter"
                        android:src="@drawable/encabezado_carnet" />


                    <!-- ========================= -->
                    <!-- DATOS DEL CARNET           -->
                    <!-- ========================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">


                        <!-- ========================= -->
                        <!-- SILUETA Y QR              -->
                        <!-- ========================= -->

                        <LinearLayout
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <!-- Silueta del socio -->

                            <ImageView
                                android:id="@+id/imgFotoSocio"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:contentDescription="@string/foto_socio"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_person"
                                app:tint="@color/text_secondary" />


                            <!-- Contenedor del código QR -->

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="62dp"
                                android:layout_height="62dp"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="@color/white"
                                app:cardCornerRadius="5dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/border"
                                app:strokeWidth="1dp">

                                <ImageView
                                    android:id="@+id/imgQrCarnet"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="0dp"
                                    android:contentDescription="@string/codigo_qr_carnet"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/qr_carnet" />

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>


                        <!-- ========================= -->
                        <!-- DATOS DEL SOCIO           -->
                        <!-- ========================= -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">


                            <!-- Número de socio -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginEnd="6dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_membership"
                                    app:tint="@color/primary" />

                                <TextView
                                    style="@style/SmallText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/numero_socio" />

                                <TextView
                                    android:id="@+id/txtNumeroSocio"
                                    style="@style/InputTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp" />

                            </LinearLayout>


                            <!-- Nombre -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginEnd="6dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_person"
                                    app:tint="@color/primary" />

                                <TextView
                                    style="@style/SmallText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nombre_carnet" />

                                <TextView
                                    android:id="@+id/txtNombreSocio"
                                    style="@style/InputTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp" />

                            </LinearLayout>


                            <!-- DNI -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginEnd="6dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_dni"
                                    app:tint="@color/primary" />

                                <TextView
                                    style="@style/SmallText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/dni_carnet" />

                                <TextView
                                    android:id="@+id/txtDniSocio"
                                    style="@style/InputTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp" />

                            </LinearLayout>


                            <!-- Estado -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginEnd="6dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_verified"
                                    app:tint="@color/primary" />

                                <TextView
                                    style="@style/SmallText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/estado" />

                                <TextView
                                    android:id="@+id/txtEstadoSocio"
                                    style="@style/InputTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp" />

                            </LinearLayout>


                            <!-- Fecha de alta -->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginEnd="6dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_calendar"
                                    app:tint="@color/primary" />

                                <TextView
                                    style="@style/SmallText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/fecha_alta" />

                                <TextView
                                    android:id="@+id/txtFechaAlta"
                                    style="@style/InputTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>


                    <!-- ========================= -->
                    <!-- FRANJA INFERIOR            -->
                    <!-- ========================= -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ========================= -->
            <!-- BOTONES                   -->
            <!-- ========================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImprimirCarnet"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/imprimir_carnet" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrInicio"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ir_inicio" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>