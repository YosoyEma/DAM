<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================= -->
    <!-- ESTILOS DE TEXTO          -->
    <!-- ========================= -->

    <!-- H1 Text - Roboto Bold 700 - 36sp -->
    <style name="H1Text">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- H2 Text - Roboto SemiBold 600 - 32sp -->
    <style name="H2Text">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/text_h2</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- H3 Subtitle - Roboto SemiBold 600 - 24sp -->
    <style name="H3Subtitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/text_h3</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Paragraph Text - Roboto Regular 400 - 20sp -->
    <style name="ParagraphText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/text_paragraph</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Menu title - Roboto ExtraBold 800 - 18sp -->
    <style name="MenuTitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:textSize">@dimen/text_menu</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Input title - Roboto Medium 500 - 16sp -->
    <style name="InputTitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">@dimen/text_input</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Input text - Roboto Medium 500 - 16sp -->
    <style name="InputText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">@dimen/text_input</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Texto pequeño auxiliar - Roboto Regular 400 - 14sp -->
    <style name="SmallText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Contenedor de campo de texto -->
    <style name="InputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <item name="hintEnabled">false</item>

        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>

    </style>

    <!-- Campo de entrada -->
    <style name="InputField" parent="InputText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>


    <!-- ========================= -->
    <!-- BOTONES                   -->
    <!-- ========================= -->

    <!-- Button Primary - Roboto SemiBold 600 - 20sp -->
    <style name="ButtonPrimary"
        parent="Widget.MaterialComponents.Button">

        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/text_paragraph</item>
        <item name="android:textColor">@color/white</item>

        <item name="backgroundTint">@color/secondary</item>
        <item name="cornerRadius">8dp</item>

        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">22dp</item>

        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <!-- Outline Button - Roboto Medium 500 - 18sp -->
    <style name="ButtonOutline"
        parent="Widget.MaterialComponents.Button.OutlinedButton">

        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">@dimen/text_menu</item>
        <item name="android:textColor">@color/primary</item>

        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">10dp</item>

        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">22dp</item>

        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Navbar superior -->
    <style name="Navbar"
        parent="Widget.MaterialComponents.Toolbar.Primary">

        <item name="android:layout_height">64dp</item>
        <item name="android:background">@color/primary</item>

        <item name="titleTextAppearance">@style/NavbarTitle</item>
        <item name="titleCentered">true</item>

        <item name="contentInsetStart">20dp</item>
        <item name="contentInsetEnd">20dp</item>

    </style>

    <!-- Navbar superior con título alineado a la izquierda -->
    <style name="NavbarLeft"
        parent="Navbar">

        <item name="titleCentered">false</item>

    </style>

    <!-- Título de Navbar -->
    <style name="NavbarTitle" parent="H3Subtitle">
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- ========================= -->
    <!-- NAVEGACIÓN INFERIOR       -->
    <!-- ========================= -->

    <!-- Barra de navegación inferior -->
    <style name="BottomNav">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/white</item>

        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>

        <item name="itemIconSize">32dp</item>

        <item name="itemTextAppearanceActive">@style/BottomNavText</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavText</item>

        <item name="itemRippleColor">@null</item>
        <item name="itemActiveIndicatorStyle">@null</item>
    </style>

    <!-- Texto del menú inferior - Roboto SemiBold 600 - 16sp -->
    <style name="BottomNavText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">@dimen/text_input</item>
    </style>

    <!-- ========================= -->
    <!-- TARJETAS DE INICIO        -->
    <!-- ========================= -->

    <style name="HomeCard"
        parent="Widget.MaterialComponents.CardView">

        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>

    </style>

    <!-- Título de las tarjetas -->
    <style name="HomeCardTitle" parent="InputTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Descripción de las tarjetas -->
    <style name="HomeCardDescription" parent="SmallText">
        <item name="android:gravity">center</item>
    </style>

    <!-- Contenedor de menú desplegable -->
    <style name="DropdownLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

        <item name="hintEnabled">false</item>

        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>

        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>

    </style>





</resources>